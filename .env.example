ENV=dev
LOG_LEVEL=INFO

# --- LLM (all required: the app will not start without them) ---
GROQ__API_KEY=your_groq_key_here
GROQ__MODEL=llama-3.3-70b-versatile
GROQ__TIMEOUT_S=15.0
GEMINI__API_KEY=your_gemini_key_here
GEMINI__MODEL=gemini/gemini-2.5-flash
LITELLM__NUM_RETRIES=2
LITELLM__TIMEOUT_S=20.0

# --- Auth (required): any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))" ---
AUTH__JWT_SECRET=change_me_to_a_long_random_string

# --- Policy search / document ingestion (docs server and /admin/ingest) ---
LLAMA_PARSER=your_llamaparse_key_here
QDRANT_HTTP=https://your-cluster-id.region.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_key_here

# --- Database (local runs only: docker-compose overrides this with the shared volume) ---
DATABASE__URL=sqlite+aiosqlite:///./data/opspilot.db
